{
  "name": "dsh-composer-draft-keeper",
  "version": "0.1.0",
  "description": "Keeps unsent composer text as a per-session draft in local storage, so it comes back after switching sessions or restarting DeepSeek Harness.",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test": "node test/selftest.mjs && node test/acceptance.mjs && node test/review.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "draft",
    "composer",
    "unsent-drafts",
    "local-storage",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0 || >=0.3.0-rc.1",
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.3.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangkohan/dsh-composer-draft-keeper.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
